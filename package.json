{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/runValidationTests.cjs && node scripts/generateHtmlReport.cjs",
    "test:unit": "node scripts/runValidationTests.cjs",
    "test:integration": "node scripts/runValidationTests.cjs",
    "test:e2e": "node scripts/runValidationTests.cjs",
    "test:coverage": "node scripts/runValidationTests.cjs",
    "test:mobile": "wdio run nodejsBaseline/tests/e2e/appium.conf.js",
    "test:load": "echo k6 load testing requires k6 binary installed separately",
    "test:report": "node scripts/generateExcelReport.cjs",
    "generate-specs": "node nodejsBaseline/tests/e2e/generate-specs.cjs",
    "qa:test": "node scripts/runValidationTests.cjs",
    "qa:excel": "node scripts/generateExcelReport.cjs",
    "qa:html": "node scripts/generateHtmlReport.cjs",
    "qa:report": "node scripts/runValidationTests.cjs && node scripts/generateHtmlReport.cjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "jest": "^29.0.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^9.0.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "vite": "^6.2.3",
    "zustand": "^5.0.13"
  },
  "optionalDependencies": {
    "appium": "^2.0.0",
    "wdio-allure-reporter": "^8.0.0",
    "wdio-chromedriver-service": "^8.0.0",
    "wdio-junit-reporter": "^8.0.0",
    "webdriverio": "^8.0.0"
  },
  "devDependencies": {
    "@esbuild/win32-x64": "^0.28.2",
    "@rollup/rollup-win32-x64-msvc": "^4.62.4",
    "@types/express": "^4.17.21",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
